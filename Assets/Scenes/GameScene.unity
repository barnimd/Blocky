  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0c5056dee807694989904535610ff13, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Blocky::GameTutorial
  gameManager: {fileID: 719914662}
  boardInput: {fileID: 491416708}
  runTimer: {fileID: 719914666}
  overlay: {fileID: 1260322713}
  tutorialStageIndex: 0
  stageSteps:
  - title: THE BOARD
    body: Line up 3 or more blocks of the same color in a row or column to clear them. New blocks fall in, and chain reactions make combos!
    target: {fileID: 1169333433}
    placement: 2
  - title: OBJECTIVE
    body: Clear this many blocks of each color to win. The numbers count down as you clear them.
    target: {fileID: 1388216874}
    placement: 0
  - title: TURNS LEFT
    body: Your total moves. Every move costs 1 turn, even if nothing matches. Finish the objective before it hits 0!
    target: {fileID: 847204710}
    placement: 0
  - title: STARS
    body: The more turns you have left when you win, the more stars you get. Watch them drop as you spend turns.
    target: {fileID: 1826098269}
    placement: 0
  - title: ACTION TURNS
    body: 'Each move type has its own limit: Horizontal, Vertical, Diagonal and Rotate. A faded slot means that move is used up.'
    target: {fileID: 153261059}
    placement: 0
  - title: HOW TO MOVE
    body: 'SWAP: drag a block onto a neighbor (diagonal too) or tap two blocks.

      ROTATE: slide across 3 blocks in an L-shape to spin a 2x2 group.'
    target: {fileID: 1169333433}
    placement: 2
  - title: YOUR TURN!
    body: Clear the objective to win Stage 1-1. Good luck!
    target: {fileID: 0}
    placement: 0
  infiniteSteps:
  - title: SCORE & TIME
    body: Every block you clear scores points, and combos multiply them. The clock runs until your run ends.
    target: {fileID: 1388216874}
    placement: 0
  - title: REFRESH
    body: Out of action turns? Tap Refresh to refill them. You only get 2 per run, so make every turn count!
    target: {fileID: 529633348}
    placement: 0
  - title: GAME OVER
    body: The run ends when your turns and refreshes are all used up, or when no move can make a match. Then tap RANKS to submit your score to the global leaderboard!
    target: {fileID: 1169333433}
    placement: 2
